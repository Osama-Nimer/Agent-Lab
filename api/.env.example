# ---- LLM provider -------------------------------------------------------------------------
# Pick ONE host. Set its key and the server auto-detects the provider (free ones win over OpenAI).
# Or force a choice with LLM_PROVIDER=groq|cerebras|openrouter|llama|gemini|ollama|openai|custom
#
# The model is chosen from the host's LIVE /models catalog at startup (first match from a
# per-provider preference list), so you do not have to track which names a free tier still serves.
# GET /api/health shows what was picked and a sample of the catalog. Pin one with LLM_MODEL=.

# Groq — RECOMMENDED free default. Serves gpt-oss-120b (OpenAI open-weight, Apache-2.0), Qwen 3.8.
#   Free key: https://console.groq.com/keys
#   Free tier = 8,000 tokens/minute: roughly ONE agent question per minute. Pace the demo accordingly.
GROQ_API_KEY=

# Cerebras — gpt-oss-120b, qwen-3.8-27b, gemma-4-31b.   https://cloud.cerebras.ai
#   NOTE (Sept 2026): a fresh Cerebras account returned 402 "Payment required" for every model, so
#   verify with one /api/ask before relying on it as a backup. Gemini or OpenRouter are safer free backups.
# CEREBRAS_API_KEY=

# OpenRouter — free routes incl. Llama where still offered (rate-limited).  https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Meta Llama API — Llama 4, preview access.                                 https://llama.developer.meta.com
# LLAMA_API_KEY=

# Google Gemini — free tier, gemini-2.5-flash.                              https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Ollama — fully local/offline, no key. `ollama pull llama3.1:8b` then:
# LLM_PROVIDER=ollama

# OpenAI — paid.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# ---- Overrides (optional) -----------------------------------------------------------------
# LLM_MODEL=            # pin a model id from the host's catalog; skips auto-selection
# LLM_BASE_URL=         # any OpenAI-compatible endpoint (required for LLM_PROVIDER=custom)
# LLM_API_KEY=          # generic key, used when the provider-specific var above is not set
# LLM_STRICT_TOOLS=     # true|false — OpenAI strict function schemas; default true only for openai
# LLM_FORCE_FIRST_TOOL= # true|false — tool_choice=required on turn 1; default true except ollama
# LLM_REASONING_EFFORT= # minimal|low|medium|high|none — sent to reasoning models (gpt-oss…); default low
# LLM_TRACING=          # true to export traces to OpenAI (openai provider only)

# ---- Server -------------------------------------------------------------------------------
PORT=3001
CLONE_DIR=./.tmp-repos
